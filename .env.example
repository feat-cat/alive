# AI Gateway (auto-provisioned by EdgeOne Makers CLI)
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash

# Tavily web search + extract (web_search / web_fetch)
TAVILY_API_KEY=

# MCP (Model Context Protocol) servers — comma-separated public HTTP server
# root URLs. Each server's `tools/list` is injected into the agent's tool table
# as `<host>_<tool>` (e.g. a `create_issue` tool on `github.example.com` becomes
# `github.example.com_create_issue`). Best-effort: an unreachable server is
# skipped and never blocks the 20 built-in tools.
# ALIVE_MCP_SERVERS=https://a.example.com/mcp,https://b.example.com/mcp

# Optional IANA timezone for the wall clock the AI sees (e.g. Asia/Shanghai).
# Unset = function-local timezone. EdgeOne Functions run in UTC, so set
# ALIVE_TZ=Asia/Shanghai for Beijing time.
ALIVE_TZ=

# Optional bearer-token auth. When set, /chat, /history and /stop require
# `Authorization: Bearer <token>`. Unset/empty keeps everything open (local dev).
# /heartbeat stays public so EdgeOne schedules can wake it without a token.
ALIVE_AUTH_TOKEN=
