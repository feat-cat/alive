# AI Gateway (auto-provisioned by EdgeOne Makers CLI)
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash

# Tavily web search
TAVILY_API_KEY=

# Optional bearer-token auth. When set, /chat, /history and /stop require
# `Authorization: Bearer <token>`. Unset/empty keeps everything open (local dev).
# /heartbeat stays public so EdgeOne schedules can wake it without a token.
ALIVE_AUTH_TOKEN=
